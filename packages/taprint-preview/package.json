{
  "name": "taprint-preview",
  "version": "1.0.0",
  "description": "Bitmap preview engine for the taprint print-template DSL: CJK text measurement and layout (opentype.js), Code128/EAN13/QR bitmaps (bwip-js), 203/300 dpi rasterization and monochrome conversion, PNG output (pngjs). Pure JavaScript — zero native dependencies, zero hardware access (ADR-0008).",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taprint/taprint.git",
    "directory": "packages/taprint-preview"
  },
  "keywords": [
    "print",
    "printer",
    "dsl",
    "preview",
    "bitmap",
    "label",
    "receipt",
    "escpos",
    "tspl",
    "thermal"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bwip-js": "^4.6.0",
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0",
    "taprint": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.19"
  }
}
