{
  "name": "taprint",
  "version": "0.1.0",
  "description": "Printer-neutral print template DSL kernel (TypeScript) — parse, validate, migrate and canonicalize templates; one contract shared across the TypeScript/C#/Dart/Java implementations.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taprint/taprint.git",
    "directory": "packages/taprint-ts"
  },
  "keywords": [
    "print",
    "printer",
    "dsl",
    "template",
    "label",
    "receipt",
    "escpos",
    "tspl",
    "cpcl"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
