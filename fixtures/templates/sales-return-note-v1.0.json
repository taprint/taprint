{
  "schemaVersion": "1.0",
  "id": "tpl_sales_return_a4_v1",
  "code": "SALES_RETURN",
  "name": "销售退货单-A4-标准",
  "category": "sales",
  "description": "销售退货单模板（doc 呈现；退货原因为必填展示项）",
  "locales": ["zh-CN"],
  "dataSources": [
    {
      "name": "main",
      "type": "primary",
      "schema": {
        "billNo": "string",
        "originBillNo": "string",
        "billDate": "date",
        "customer": { "name": "string", "phone": "string" },
        "store": { "name": "string" },
        "operator": "string",
        "reason": "string",
        "refundAmount": "number"
      }
    },
    {
      "name": "items",
      "type": "detail",
      "schema": {
        "sku": "string",
        "name": "string",
        "spec": "string",
        "qty": "number",
        "unit": "string",
        "price": "number",
        "amount": "number"
      }
    }
  ],
  "presentations": {
    "doc": {
      "page": {
        "size": "A4",
        "margin": { "top": "15mm", "right": "15mm", "bottom": "15mm", "left": "15mm" },
        "orientation": "portrait"
      },
      "header": [
        {
          "type": "text",
          "content": "{{store.name}} 销售退货单",
          "style": { "fontSize": 18, "bold": true },
          "align": "center"
        }
      ],
      "body": [
        {
          "type": "kvtable",
          "columns": 3,
          "rows": [
            [
              ["退货单号", "{{billNo}}"],
              ["原销售单", "{{originBillNo}}"],
              ["日期", "{{billDate | date:'YYYY-MM-DD'}}"]
            ],
            [
              ["客户", "{{customer.name}}"],
              ["电话", "{{customer.phone}}"],
              ["操作员", "{{operator}}"]
            ]
          ]
        },
        {
          "type": "table",
          "source": "items",
          "columns": [
            { "header": "SKU", "field": "sku", "width": "20%" },
            { "header": "商品名称", "field": "name", "width": "32%" },
            { "header": "规格", "field": "spec", "width": "15%" },
            { "header": "退货数量", "field": "qty", "align": "right", "width": "12%" },
            {
              "header": "单价",
              "field": "price",
              "align": "right",
              "format": "currency:CNY",
              "width": "10%"
            },
            {
              "header": "金额",
              "field": "amount",
              "align": "right",
              "format": "currency:CNY",
              "width": "11%"
            }
          ],
          "summary": [
            { "label": "退款合计", "value": "{{refundAmount | currency:CNY}}", "align": "right" }
          ]
        },
        { "type": "text", "content": "退货原因：{{reason}}", "margin": { "top": "6mm" } }
      ],
      "footer": [
        {
          "type": "text",
          "content": "客户签字：____________    收货人签字：____________",
          "margin": { "top": "18mm" }
        }
      ]
    }
  },
  "parameters": [
    {
      "name": "copies",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 99,
      "description": "打印份数"
    }
  ]
}
