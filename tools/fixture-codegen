def parse_matrix() -> dict[tuple[str, str], int]:
    """Parse docs/coverage-matrix.md frozen table -> {(protocol, feature): count}."""
    required: dict[tuple[str, str], int] = {}
    columns = {"ESC/POS": 3, "TSPL": 4, "CPCL": 5, "ZPL (v0.2)": 6}
    protocols = {"ESC/POS": "escpos", "TSPL": "tspl", "CPCL": "cpcl", "ZPL (v0.2)": "zpl"}
    for line in MATRIX.read_text(encoding="utf-8").splitlines():
        match = re.match(r"^\|\s*(\d+)\s*\|", line)
        if not match:
            continue
        row = int(match.group(1))
        if row not in FEATURE_SLUGS:
            continue
        parts = [p.strip() for p in line.split("|")[1:-1]]
        if len(parts) < 6:
            continue
        for name, index in columns.items():
            protocol = protocols[name]
            if protocol == "zpl":
                continue
            cell = parts[index - 1]
            if cell in ("—", "-", ""):
                continue
            required[(protocol, FEATURE_SLUGS[row])] = int(cell)
    return required


def feature_slug(cell_feature: str) -> str:
    return re.sub(r"[^a-z0-9-]", "", cell_feature.strip().lower().replace(" ", "-"))


def verify_coverage(required: dict[tuple[str, str], int]) -> None:
    covered: dict[tuple[str, str], int] = {}
    specials = set()
    for case in CASES:
        for cell in case.get("matrixCells", []):
            key = (cell["protocol"], feature_slug(cell["feature"]))
            covered[key] = covered.get(key, 0) + 1
        if case.get("special"):
            specials.add(case["special"])
    gaps = []
    for key, want in sorted(required.items()):
        have = covered.get(key, 0)
        if have < max(1, want):
            gaps.append(f"{key[0]}:{key[1]} have={have} want>={max(1, want)}")
    if gaps:
        raise SystemExit("coverage gaps:\n  " + "\n  ".join(gaps))
    for mandatory in ("rounding-midpoint", "unmapped-char", "float-ratio", "identity-fn"):
        if mandatory not in specials:
            raise SystemExit(f"missing mandatory special: {mandatory}")
    identity = [c for c in CASES if c.get("containsIdentityFn")]
    if len(identity) != 1:
        raise SystemExit("exactly one identity-fn case expected")


def emit_cases() -> None:
    CASES_DIR.mkdir(parents=True, exist_ok=True)
    for old in CASES_DIR.glob("*.json"):
        old.unlink()
    for case in CASES:
        doc = {
            "schema": CASE_SCHEMA,
            "id": case["id"],
            "title": case["title"],
            "profile": case["profile"],
            "protocols": case["protocols"],
            "containsIdentityFn": bool(case.get("containsIdentityFn")),
            "special": case.get("special"),
            "matrixCells": case.get("matrixCells", []),
            "input": case["input"],
        }
        (CASES_DIR / f"{case['id']}.json").write_text(
            json.dumps(doc, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def emit_manifest(l2_green: dict[str, list[str]]) -> None:
    entries = []
    for case in CASES:
        l1 = True
        l2 = not case.get("containsIdentityFn")
        green = {"java": l2}
        for lang, ids in l2_green.items():
            if lang != "java":
                green[lang] = l2 and case["id"] in ids
        entries.append({
            "case": case["id"],
            "file": f"cases/{case['id']}.json",
            "profile": case["profile"],
            "protocols": case["protocols"],
            "containsIdentityFn": bool(case.get("containsIdentityFn")),
            "special": case.get("special"),
            "matrixCells": case.get("matrixCells", []),
            "layers": {"l1": l1, "l2": l2},
            "l2Assert": green,
        })
    manifest = {
        "schema": MANIFEST_SCHEMA,
        "generatedBy": "tools/fixture-codegen",
        "referenceLang": "java",
        "layers": {
            "l1": "expected/commands/<case>/<lang>/<protocol>.frames.txt",
            "l2": "expected/commands/<case>/<lang>/<protocol>.bytes.sha256",
        },
        "caseCount": len(entries),
        "cases": entries,
    }
    (FIXTURES / "manifest.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def run_java_generator() -> None:
    module = REPO / "packages" / "taprint-java"
    mvn = shutil.which("mvn") or str(Path("/tmp/maven/bin/mvn"))
    subprocess.run([mvn, "-q", "test-compile", "-DskipTests"], cwd=module, check=True)
    cp_file = module / "target" / "golden.classpath"
    subprocess.run([mvn, "-q", "dependency:build-classpath",
                    f"-Dmdep.outputFile={cp_file}"], cwd=module, check=True)
    cp = ["target/classes", "target/test-classes", cp_file.read_text().strip()]
    subprocess.run(["java", "-cp", ":".join(str(p) for p in cp),
                    "dev.taprint.golden.GenerateGoldenExpected",
                    str(FIXTURES)], cwd=module, check=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--skip-java", action="store_true", help="只再生成用例与 manifest")
    parser.add_argument("--l2-green", action="append", default=[],
                        help="lang=case1,case2 —— 标记该语言当前字节全等（L2 断言）的用例")
    args = parser.parse_args()

    required = parse_matrix()
    verify_coverage(required)
    emit_cases()
    green: dict[str, list[str]] = {}
    for item in args.l2_green:
        lang, _, ids = item.partition("=")
        green[lang] = [i for i in ids.split(",") if i]
    emit_manifest(green)
    print(f"[codegen] cases={len(CASES)} matrix-cells={len(required)}")

    if not args.skip_java:
        run_java_generator()
    return 0


if __name__ == "__main__":
    sys.exit(main())
