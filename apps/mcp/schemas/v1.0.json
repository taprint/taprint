{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taprint.dev/schema/v1.0.json",
  "title": "taprint Print Template DSL v1.0",
  "description": "打印模板 DSL v1.0 权威定稿。方言 JSON Schema 2020-12（元素 oneOf 组合需 unevaluatedProperties）。字段语义依据 字段语义规范：顶层不含 tenantId/storeId（归属服务端注入，§5.2 安全修正）；schemaVersion 用 pattern 不用 enum；code 注册表驱动、schema 只校格式。fixtures 一致性由 tests/ + tools/schema-lint 锁定（本规范）。",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "code",
    "name",
    "presentations"
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "tenantId"
        ]
      },
      {
        "required": [
          "storeId"
        ]
      }
    ]
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "DSL schema 版本（允许 1.0/1.1/...，渲染器维护兼容表，§5.11/§5.12）"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,31}$",
      "description": "业务单据代码；格式校验，有效性由服务端 BizTypeRegistry 校"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z0-9]{2,8})?$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/dataSource"
      }
    },
    "presentations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "doc": {
          "$ref": "#/definitions/docPresentation"
        },
        "receipt": {
          "$ref": "#/definitions/receiptPresentation"
        },
        "label": {
          "$ref": "#/definitions/labelPresentation"
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/parameter"
      }
    },
    "i18n": {
      "type": "object",
      "description": "多语言词条，key 为 locale",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Z0-9]{2,8})?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "扩展位，不参与校验语义"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "length": {
      "type": "string",
      "description": "物理长度，非负；mm 为主单位，cm/pt/px 由渲染端换算。% 无几何参照物（TSPL/ESC-POS 绝对坐标），不支持；表格列宽相对值用 columnWidth",
      "pattern": "^\\d+(\\.\\d+)?(mm|cm|pt|px)$"
    },
    "columnWidth": {
      "type": "string",
      "description": "表格列宽：物理长度或相对表格宽度的百分比（doc 流式布局合法场景）",
      "pattern": "^\\d+(\\.\\d+)?(mm|cm|pt|px|%)$"
    },
    "style": {
      "type": "object",
      "description": "样式，继承链 page → body → element",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "enum": [
                "normal",
                "double",
                "quadruple"
              ]
            }
          ],
          "description": "doc/label 用数值 pt；receipt 用 normal/double/quadruple"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "color": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
        },
        "backgroundColor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "verticalAlign": {
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "border": {
          "$ref": "#/definitions/boxEdges"
        },
        "padding": {
          "$ref": "#/definitions/boxEdges"
        }
      }
    },
    "boxEdges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": [
            "string",
            "number"
          ]
        },
        "right": {
          "type": [
            "string",
            "number"
          ]
        },
        "bottom": {
          "type": [
            "string",
            "number"
          ]
        },
        "left": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "marginEdges": {
      "type": "object",
      "description": "边距盒模型：四边必须为 length（评审 S1：无单位数字的 px/mm 语义不明，禁止）",
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/definitions/length"
        },
        "right": {
          "$ref": "#/definitions/length"
        },
        "bottom": {
          "$ref": "#/definitions/length"
        },
        "left": {
          "$ref": "#/definitions/length"
        }
      }
    },
    "dataSource": {
      "type": "object",
      "required": [
        "name",
        "type",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "primary",
            "detail",
            "reference"
          ]
        },
        "schema": {
          "$ref": "#/definitions/fieldSchema"
        }
      }
    },
    "fieldSchema": {
      "type": "object",
      "description": "字段字典：叶子为类型名，嵌套对象为子结构",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "date",
              "datetime",
              "enum"
            ]
          },
          {
            "$ref": "#/definitions/fieldSchema"
          }
        ]
      }
    },
    "expression": {
      "type": "string",
      "description": "可含 {{...}} 表达式"
    },
    "docPresentation": {
      "type": "object",
      "description": "A4 单据呈现，流式布局",
      "required": [
        "page",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "object",
          "required": [
            "size"
          ],
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "enum": [
                "A4",
                "A5",
                "LETTER",
                "CUSTOM"
              ]
            },
            "width": {
              "$ref": "#/definitions/length"
            },
            "height": {
              "$ref": "#/definitions/length"
            },
            "margin": {
              "$ref": "#/definitions/marginEdges"
            },
            "orientation": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape"
              ]
            }
          }
        },
        "style": {
          "$ref": "#/definitions/style"
        },
        "header": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/flowElement"
          }
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/flowElement"
          }
        },
        "footer": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/flowElement"
          }
        }
      }
    },
    "receiptPresentation": {
      "type": "object",
      "description": "ESC/POS 小票呈现，流式布局",
      "required": [
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/definitions/length"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "gbk",
            "utf-8"
          ]
        },
        "initCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/receiptElement"
          }
        },
        "tailCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "labelPresentation": {
      "type": "object",
      "description": "TSPL 标签呈现，绝对坐标布局（元素必须带 x/y）",
      "required": [
        "size",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "$ref": "#/definitions/length"
            },
            "height": {
              "$ref": "#/definitions/length"
            }
          }
        },
        "gap": {
          "$ref": "#/definitions/length"
        },
        "density": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "speed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/labelElement"
          }
        },
        "copies": {
          "$ref": "#/definitions/expression"
        },
        "endCommand": {
          "$ref": "#/definitions/expression"
        }
      }
    },
    "elementBase": {
      "type": "object",
      "properties": {
        "style": {
          "$ref": "#/definitions/style"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "margin": {
          "$ref": "#/definitions/marginEdges"
        },
        "width": {
          "$ref": "#/definitions/length"
        },
        "height": {
          "$ref": "#/definitions/length"
        }
      }
    },
    "flowElement": {
      "description": "doc 流式元素（§5.4 元素类型表）",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "content": {
              "$ref": "#/definitions/expression"
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "src"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "src": {
              "$ref": "#/definitions/expression"
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content",
            "symbology"
          ],
          "properties": {
            "type": {
              "const": "barcode"
            },
            "content": {
              "$ref": "#/definitions/expression"
            },
            "symbology": {
              "type": "string",
              "enum": [
                "CODE128",
                "EAN13",
                "UPC",
                "EAN8",
                "CODE39",
                "ITF"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "qrcode"
            },
            "content": {
              "$ref": "#/definitions/expression"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "source",
            "columns"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "source": {
              "type": "string",
              "description": "数据源名（dataSources[].name）"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "header",
                  "field"
                ],
                "additionalProperties": false,
                "properties": {
                  "header": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "width": {
                    "$ref": "#/definitions/columnWidth"
                  },
                  "align": {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  },
                  "format": {
                    "type": "string"
                  }
                }
              }
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/definitions/expression"
                  },
                  "align": {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "kvtable"
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "compact": {
              "type": "boolean"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "$ref": "#/definitions/expression"
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "line"
            },
            "lineStyle": {
              "type": "string",
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "rect"
            },
            "border": {
              "$ref": "#/definitions/boxEdges"
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/elementBase"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "height"
          ],
          "properties": {
            "type": {
              "const": "spacer"
            },
            "height": {
              "$ref": "#/definitions/length"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "pageBreak"
            }
          }
        }
      ]
    },
    "receiptElement": {
      "description": "receipt 元素 = flow 元素 + ESC/POS 特有元素（§5.5：cut/cashDrawer）",
      "oneOf": [
        {
          "$ref": "#/definitions/flowElement"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "cut"
            },
            "partial": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "cashDrawer"
            },
            "pulse": {
              "type": "integer",
              "enum": [
                1,
                2
              ]
            }
          }
        }
      ]
    },
    "labelElement": {
      "description": "label 元素：绝对坐标（x/y 必填，§5.6）",
      "type": "object",
      "allOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "content"
              ],
              "properties": {
                "type": {
                  "const": "text"
                },
                "content": {
                  "$ref": "#/definitions/expression"
                },
                "font": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "content",
                "symbology"
              ],
              "properties": {
                "type": {
                  "const": "barcode"
                },
                "content": {
                  "$ref": "#/definitions/expression"
                },
                "symbology": {
                  "type": "string",
                  "enum": [
                    "CODE128",
                    "EAN13",
                    "UPC",
                    "EAN8",
                    "CODE39",
                    "ITF"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "content"
              ],
              "properties": {
                "type": {
                  "const": "qrcode"
                },
                "content": {
                  "$ref": "#/definitions/expression"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "src"
              ],
              "properties": {
                "type": {
                  "const": "image"
                },
                "src": {
                  "$ref": "#/definitions/expression"
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "$ref": "#/definitions/length"
            },
            "y": {
              "$ref": "#/definitions/length"
            },
            "width": {
              "$ref": "#/definitions/length"
            },
            "height": {
              "$ref": "#/definitions/length"
            },
            "align": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "style": {
              "$ref": "#/definitions/style"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "parameter": {
      "type": "object",
      "description": "运行时参数",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "integer",
            "number",
            "string",
            "boolean"
          ]
        },
        "default": {
          "type": [
            "integer",
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
